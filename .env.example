# Trippo Agent — environment variables
# Copy to .env (never commit .env). All vars optional in MOCK mode.

# Mocking — when true, use mocked Gemini + canned external search results.
# The integration test relies on this.
MOCK=true

# MongoDB — for production / dev against real Atlas. Tests use mongodb-memory-server.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/trippo
# Default true in the API server. Set false only for direct-driver debugging.
MONGODB_MCP_ENABLED=true

# Google Cloud — needed once we deploy to Vertex AI Agent Builder.
# GOOGLE_CLOUD_PROJECT=theta-bliss-486220-s1
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Gemini API — optional fallback when AGENT_PROVIDER=gemini.
# GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Vertex Embeddings + Atlas Vector Search — used for rated trip-memory retrieval.
VERTEX_EMBEDDINGS_ENABLED=true
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIMENSIONS=768
ATLAS_VECTOR_SEARCH_INDEX=trip_memories_vector

# API server port
PORT=4000
